# ============================================================
# 5분 시초가 돌파 매매 시스템 v10 - 환경 변수 설정
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
# .env 는 절대 git 에 커밋하지 마세요 (.gitignore 에 이미 등록됨).
# ============================================================

# ---------------- 운영 모드 ----------------
# paper: 모의투자(KIS 모의투자 서버) / live: 실전투자(실제 자금 체결)
# 반드시 paper 로 최소 1~2주 이상 검증 후 live 로 전환할 것.
TRADING_MODE=paper

# ---------------- 한국투자증권 KIS API v2 ----------------
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
# 계좌번호 앞 8자리
KIS_CANO=00000000
# 계좌상품코드 뒤 2자리 (통상 위탁종합계좌 01)
KIS_ACNT_PRDT_CD=01

# ---------------- Naver 검색 Open API ----------------
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# ---------------- Google Gemini API (Free Tier) ----------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
# 무료 등급 15 RPM 한도 보호용 최소 호출 간격(초)
GEMINI_THROTTLE_SECONDS=4.5

# ---------------- Telegram Bot ----------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# 알림이 발송되는 그룹(또는 개인) 채팅방 chat_id. 필수. 알림 수신 전용 - 이 채팅방에서 보낸
# /status 등 명령어는 거부된다 (그룹에 초대된 다른 사람이 명령을 실행하지 못하게 하기 위함).
TELEGRAM_CHAT_ID=-1001234567890
# 본인 개인 DM chat_id. 대시보드 로그인 코드(OTP) 수신 + 명령어 실행에 쓰인다. 비워두면 아무도
# 명령어를 실행할 수 없으니 반드시 채워야 한다.
TELEGRAM_USER_CHAT_ID=123456789
# (선택) 명령어 실행만 추가로 허용할 사람들의 개인 DM chat_id. 콤마로 구분해 여러 명 등록 가능
# (예: "111111,222222"). 로그인 코드는 이 목록에는 전송되지 않는다.
TELEGRAM_EXTRA_COMMAND_CHAT_IDS=

# ---------------- 자금 / 리스크 관리 ----------------
MAX_SLOTS=3
SLOT_ALLOCATION_PCT=0.30
TARGET_PROFIT_PCT=0.05
STOP_LOSS_PCT=-0.03
SLIPPAGE_PCT=0.002
INDEX_CRASH_THRESHOLD_PCT=-1.2
GAP_UP_MAX_PCT=5.0
ENTRY_WINDOW_START=09:00:00
ENTRY_WINDOW_END=09:30:00
MARKET_CLOSE_TIME=15:30:00
EOD_SNAPSHOT_TIME=15:35:00
PRE_SCREEN_TIME=08:50:00
MIN_PREV_TRADE_AMOUNT=15000000000
STRONG_GAIN_THRESHOLD_PCT=20.0
LITERAL_LIMIT_UP_PCT=29.5

# ---------------- 웹 대시보드 (텔레그램 일회용 코드 로그인, 조회 전용) ----------------
WEB_ENABLED=true
# 로컬 테스트: 127.0.0.1 (본인 컴퓨터에서만 접속 가능)
# VM 배포 후 외부에서 보려면: 0.0.0.0 으로 바꾸고 오라클 클라우드 보안목록에서 포트를 열어야 함
WEB_HOST=127.0.0.1
WEB_PORT=8080
# 비워두면 프로세스 재시작마다 로그인이 풀림. 계속 로그인 유지하려면 고정값 입력 (openssl rand -hex 32)
WEB_SECRET_KEY=

# ---------------- 데이터베이스 ----------------
DB_PATH=data/trading_bot.db

# ---------------- 로그 ----------------
LOG_LEVEL=INFO
LOG_PATH=logs/trading_bot.log
# 매일 자정 로그 파일 회전, 최근 N일치만 보관 (그 이전은 자동 삭제)
LOG_RETENTION_DAYS=7
